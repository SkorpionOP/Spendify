{
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "backend/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/main.py"
        },
        {
            "src": "/assets/(.*)",
            "dest": "frontend/dist/assets/$1"
        },
        {
            "src": "/sw.js",
            "dest": "frontend/dist/sw.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "src": "/workbox-(.*)\\.js",
            "dest": "frontend/dist/workbox-$1.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            }
        },
        {
            "src": "/manifest\\.(webmanifest|json)",
            "dest": "frontend/dist/manifest.$1"
        },
        {
            "src": "/favicon\\.(ico|svg)",
            "dest": "frontend/dist/favicon.$1"
        },
        {
            "src": "/icon(.*)\\.png",
            "dest": "frontend/dist/icon$1.png"
        },
        {
            "src": "/icon\\.svg",
            "dest": "frontend/dist/icon.svg"
        },
        {
            "src": "/(.*)",
            "dest": "frontend/dist/index.html"
        }
    ]
}
