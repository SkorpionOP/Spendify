# Copy to .env.local for local testing, and add the same variables in Vercel → Settings → Environment Variables.
# Server-side only: never prefix these with VITE_ (that would put them in the app bundle).
GROQ_API_KEY=
# Optional. Default: openai/gpt-oss-120b
GROQ_MODEL=
# Optional. The model that reads receipt photos. Default: qwen/qwen3.8-27b (a Groq preview model)
GROQ_VISION_MODEL=

# Rate limit per visitor for the AI endpoint. Defaults: 12 a minute, 150 a day.
AI_RATE_PER_MINUTE=
AI_RATE_PER_DAY=
# Optional, recommended for a public site: Upstash Redis (free tier is plenty) so the limit is shared by
# every serverless instance. Without it each instance counts on its own (best effort).
# Vercel KV / Upstash from the Vercel Marketplace sets KV_REST_API_URL / KV_REST_API_TOKEN, which also work.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional: other sites allowed to call the API (comma-separated origins). The app's own site is always allowed.
ALLOWED_ORIGINS=
