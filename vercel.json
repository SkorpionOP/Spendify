{
    "builds": [
        {
            "src": "frontend/package.json",
            "use": "@vercel/static-build",
            "config": {
                "distDir": "dist"
            }
        },
        {
            "src": "backend/main.py",
            "use": "@vercel/python"
        }
    ],
    "routes": [
        {
            "src": "/api/(.*)",
            "dest": "backend/main.py"
        },
        {
            "src": "/sw.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            },
            "dest": "/sw.js"
        },
        {
            "src": "/workbox-(.*)\\.js",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            },
            "dest": "/workbox-$1.js"
        },
        {
            "src": "/manifest\\.(json|webmanifest)",
            "headers": {
                "Cache-Control": "no-cache, no-store, must-revalidate"
            },
            "dest": "/manifest.$1"
        },
        {
            "src": "/(.*)",
            "dest": "/index.html"
        }
    ]
}
